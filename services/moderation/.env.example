APP_HOST=0.0.0.0
APP_PORT=8002

POSTGRES_DB=moderation
POSTGRES_PORT=5434
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL="postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@moderation-db:5432/${POSTGRES_DB}"
DATABASE_VERBOSE=false

# Service-to-service key expected from B2B on POST /api/v1/events/product
B2B_SERVICE_KEY="your_b2b_service_key_here"

# JWT settings for moderator-facing endpoints (shared with other services)
SECRET_KEY="your_secret_key_here"
ALGORITHM="HS256"

# Outgoing service-to-service call to B2B's POST /api/v1/moderation/events
B2B_BASE_URL="http://b2b:8000"
B2B_MODERATION_SERVICE_KEY="your_moderation_service_key_here"
